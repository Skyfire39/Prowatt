# Paiement MVola (https://developer.mvola.mg). Copier ce fichier en .env.local et le remplir.
# Ne jamais commiter .env.local : il contient des secrets.

# Clés de l'application déclarée sur MVola Developer (onglet Subscriptions > SANDBOX KEYS).
MVOLA_CONSUMER_KEY=
MVOLA_CONSUMER_SECRET=

# Numéro MVola marchand qui reçoit les paiements (format 03XXXXXXXX).
# En sandbox, utiliser uniquement les numéros de test 0343500003 / 0343500004.
MVOLA_MERCHANT_MSISDN=

# Nom du partenaire envoyé à MVola.
MVOLA_PARTNER_NAME=Prowatt Madagascar

# sandbox (par défaut, https://devapi.mvola.mg) ou production (https://api.mvola.mg, après GO LIVE).
MVOLA_ENV=sandbox
# MVOLA_BASE_URL=            # surcharge facultative de l'URL de base

# Adresse publique HTTPS de rappel, facultative : https://votre-site.mg/api/mvola/callback
# Sans elle, le paiement fonctionne par interrogation du statut (polling).
MVOLA_CALLBACK_URL=

# Simulation locale sans clés (développement uniquement, ignorée en production) : 1 pour activer.
# Le paiement se « confirme » après ~6 s ; le numéro 0340000000 simule un échec.
MVOLA_MOCK=
